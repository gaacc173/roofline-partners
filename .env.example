# Application
NEXT_PUBLIC_APP_NAME="Roofline Partners"
NEXT_PUBLIC_APP_URL="https://rooflinepartners.com"

# Google Sheets lead capture (required to accept lead submissions)
# Deploy google-apps-script/Code.gs as an Apps Script Web App, then paste
# the deployed URL here.
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Optional: Cloudflare Turnstile (enforce before public launch if configured)
# TURNSTILE_SECRET_KEY=

# Analytics (Milestone 4 — set to true to enable event tracking)
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
