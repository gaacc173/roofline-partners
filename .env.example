# Application
NEXT_PUBLIC_APP_NAME="Roofline Partners"
NEXT_PUBLIC_APP_URL="https://rooflinepartners.com"

# Supabase (required to accept lead submissions)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=

# Resend (required to notify the sales team)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Roofline Partners <leads@yourdomain.com>"
# LEAD_NOTIFICATION_EMAIL="owner@yourdomain.com"

# Optional: Cloudflare Turnstile (enforce before public launch if configured)
# TURNSTILE_SECRET_KEY=

# Analytics (future integration)
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
